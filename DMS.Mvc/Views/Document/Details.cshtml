@model HRDms.Data.Models.DocumentDetailViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Doküman Detayı - @Model.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body class="bg-light p-4">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="/Document/Index" class="btn btn-outline-secondary">&larr; Listeye Dön</a>

            <div>
                @if ((Model.CurrentStatus == "Draft" || Model.CurrentStatus == "Pending")
                                && Context.Session.GetString("IsManager") == "true")
                {
                    <form asp-action="ChangeStatus" method="post" style="display:inline;">
                        <input type="hidden" name="documentId" value="@Model.DocumentID" />
                        <input type="hidden" name="newStatus" value="Approved" />
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Onayla</button>
                    </form>

                    <form asp-action="ChangeStatus" method="post" style="display:inline;">
                        <input type="hidden" name="documentId" value="@Model.DocumentID" />
                        <input type="hidden" name="newStatus" value="Rejected" />
                        <button type="submit" class="btn btn-danger ms-1"><i class="bi bi-x-circle"></i> Reddet</button>
                    </form>
                }

                else if (Model.CurrentStatus == "Rejected" && Context.Session.GetString("IsManager") == "true")
                {
                    <form asp-action="ChangeStatus" method="post" style="display:inline;">
                        <input type="hidden" name="documentId" value="@Model.DocumentID" />
                        <input type="hidden" name="newStatus" value="Pending" />
                        <button type="submit" class="btn btn-warning text-dark"><i class="bi bi-arrow-counterclockwise"></i> Tekrar Değerlendir</button>
                    </form>
                }

                else if (Model.CurrentStatus == "Pending" && Context.Session.GetString("IsManager") != "true")
                {
                    <span class="text-muted fst-italic"><i class="bi bi-hourglass-split"></i> Yöneticinizden onay bekleniyor...</span>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">@Model.Title</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Kategori:</strong> <br>
                                <span class="badge bg-info text-dark">@Model.CategoryName</span>
                            </div>
                            <div class="col-md-6 text-end">
                                <strong>Mevcut Durum:</strong> <br>
                                <span class="badge bg-secondary fs-6">@Model.CurrentStatus</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <strong>Açıklama:</strong>
                            <p class="text-muted border p-3 rounded bg-light mt-1">
                                @(string.IsNullOrEmpty(Model.Description) ? "Açıklama girilmemiş." : Model.Description)
                            </p>
                        </div>

                        <div class="row text-muted">
                            <div class="col-md-6">
                                <small>Yükleyen:</small> <strong>@Model.OwnerName</strong>
                            </div>
                            <div class="col-md-6">
                                <small>Tarih:</small> <strong>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>

                        <hr />

                        @if (!string.IsNullOrEmpty(Model.FilePath))
                        {
                            <a href="/Document/DownloadFile/@Model.DocumentID" class="btn btn-primary w-100">
                                <i class="bi bi-download"></i> Dosyayı İndir (@Model.FileName)
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-warning">Dosya bulunamadı.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> İşlem Geçmişi</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped mb-0 text-center" style="font-size: 0.9rem;">
                            <thead>
                                <tr>
                                    <th>Durum</th>
                                    <th>Kişi</th>
                                    <th>Zaman</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.History != null && Model.History.Count > 0)
                                {
                                    foreach (var log in Model.History)
                                    {
                                        <tr>
                                            <td>@log.Status</td>
                                            <td>@log.ChangedByName</td>
                                            <td>@log.ChangeDate.ToString("dd.MM HH:mm")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted py-3">Henüz işlem geçmişi yok.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-layers-half"></i> Versiyon Geçmişi</h5>

                        <button type="button" class="btn btn-sm btn-light text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#newVersionModal">
                            <i class="bi bi-plus-circle"></i> Yeni Versiyon Yükle
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-bordered table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Versiyon</th>
                                    <th>Dosya Adı</th>
                                    <th>Yükleyen</th>
                                    <th>Tarih</th>
                                    <th>Not</th>
                                    @if (Context.Session.GetString("IsManager") == "true")
                                    {
                                        <th style="width: 150px;">Yönetici</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ver in Model.Versions)
                                {
                                    // İlk satır (En güncel sürüm) yeşil yansın
                                    var isLatest = (ver == Model.Versions.First());
                                    <tr class="@(isLatest ? "table-success" : "")">
                                        <td class="fw-bold">v.@ver.VersionNumber</td>
                                        <td>@ver.FileName</td>
                                        <td>@ver.UploadedByName</td>
                                        <td>@ver.UploadDate?.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@ver.ChangeNote</td>

                                        @if (Context.Session.GetString("IsManager") == "true")
                                        {
                                            <td class="text-center">
                                                @if (!isLatest) // En güncel olana dönülmez, eskiler seçilir
                                                {
                                                    <form asp-action="RollbackVersion" method="post" onsubmit="return confirm('Bu versiyona geri dönmek istediğinize emin misiniz?');">
                                                        <input type="hidden" name="versionId" value="@ver.VersionID" />
                                                        <input type="hidden" name="documentId" value="@Model.DocumentID" />
                                                        <button type="submit" class="btn btn-sm btn-outline-dark">
                                                            <i class="bi bi-arrow-counterclockwise"></i> Geri Dön
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Güncel</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="newVersionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Yeni Versiyon Yükle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <form action="/Document/UploadNewVersion" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        <input type="hidden" name="documentId" value="@Model.DocumentID" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Dosya Seçin</label>
                            <input type="file" name="file" class="form-control" accept=".pdf,.docx,.xlsx,.jpg,.png" required />
                            <small class="text-muted">Önceki versiyon silinmez, arşivlenir.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Değişiklik Notu</label>
                            <textarea name="changeNote" class="form-control" rows="2" placeholder="Örn: Yazım hataları düzeltildi..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-success">Yükle ve Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>