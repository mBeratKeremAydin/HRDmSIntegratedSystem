@* HR.Mvc/Views/PerformanceReviews/Create.cshtml – Performans ekleme formu *@
@model HRDms.Data.Models.PerformanceReview

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Performans Değerlendirmesi Ekle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container-custom {
            max-width: 800px;
            margin: 0 auto;
        }

        .back-button {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            color: #4a5568;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

            .back-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                color: #667eea;
            }

        .form-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 40px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .form-title {
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .form-subtitle {
            color: #718096;
            font-size: 1rem;
        }

        .employee-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 0.95rem;
            font-weight: 600;
            margin-top: 10px;
        }

        .form-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .form-label i {
                color: #a0aec0;
            }

        .required {
            color: #fc5c65;
        }

        .form-control, .form-select {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                outline: none;
            }

        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }

        .score-slider-container {
            position: relative;
            padding: 15px 0;
        }

        .score-display {
            text-align: center;
            margin-bottom: 15px;
        }

        .score-value {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .score-label-text {
            font-size: 1.1rem;
            color: #718096;
            margin-top: 5px;
        }

        input[type="range"] {
            width: 100%;
            height: 8px;
            border-radius: 5px;
            background: #e2e8f0;
            outline: none;
            -webkit-appearance: none;
        }

            input[type="range"]::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                cursor: pointer;
                box-shadow: 0 2px 10px rgba(102, 126, 234, 0.5);
            }

            input[type="range"]::-moz-range-thumb {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                cursor: pointer;
                border: none;
            }

        .score-indicators {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            color: #a0aec0;
            margin-top: 8px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 14px 40px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            }

        .btn-cancel {
            background: white;
            color: #4a5568;
            padding: 14px 40px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-cancel:hover {
                border-color: #cbd5e0;
                transform: translateY(-2px);
                color: #4a5568;
            }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 15px 20px;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .form-card {
                padding: 25px;
            }

            .form-title {
                font-size: 1.5rem;
            }

            .score-value {
                font-size: 2.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "PerformanceReviews", new { employeeId = Model.EmployeeId }))" class="back-button">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>

        <div class="form-card">
            <div class="form-header">
                <h1 class="form-title">
                    <i class="fas fa-chart-line"></i> Performans Değerlendirmesi Ekle
                </h1>
                <p class="form-subtitle">
                    @if (ViewBag.EmployeeName != null)
                    {
                        <span class="employee-badge">
                            <i class="fas fa-user"></i> @ViewBag.EmployeeName
                        </span>
                    }
                </p>
            </div>

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Hata!</strong> Lütfen formu kontrol edin.
                    @Html.ValidationSummary(false, "", new { @class = "mb-0 mt-2" })
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- ÇOK ÖNEMLİ: EmployeeId post'a gidecek -->
                <input type="hidden" asp-for="EmployeeId" />

                <!-- Geri dönüş adresini de taşıyalım -->
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="ReviewDate" class="form-label">
                        <i class="fas fa-calendar-alt"></i> Değerlendirme Tarihi
                    </label>
                    <input asp-for="ReviewDate" type="date" class="form-control" required />
                    <span asp-validation-for="ReviewDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Score" class="form-label">
                        <i class="fas fa-star"></i> Performans Puanı (0 - 100)
                    </label>
                    <input asp-for="Score" 
                           type="number" 
                           min="0" 
                           max="100" 
                           class="form-control" 
                           required />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">
                        <i class="fas fa-comment-alt"></i> Değerlendirme Notları
                    </label>
                    <textarea asp-for="Notes" 
                              class="form-control" 
                              rows="4"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "PerformanceReviews", new { employeeId = Model.EmployeeId }))" 
                       class="btn-cancel">
                        <i class="fas fa-times"></i> İptal
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save"></i> Kaydet  
                    </button>
                </div 
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        function updateScore(value) {
            const scoreDisplay = document.getElementById('scoreDisplay');
            const scoreLabel = document.getElementById('scoreLabel');
            
            scoreDisplay.textContent = value;
            
            if (value >= 85) {
                scoreLabel.textContent = 'Mükemmel';
                scoreLabel.style.color = '#38ef7d';
            } else if (value >= 70) {
                scoreLabel.textContent = 'İyi';
                scoreLabel.style.color = '#4facfe';
            } else if (value >= 50) {
                scoreLabel.textContent = 'Orta';
                scoreLabel.style.color = '#fee140';
            } else {
                scoreLabel.textContent = 'Geliştirilmeli';
                scoreLabel.style.color = '#f5576c';
            }
        }

        // Sayfa yüklendiğinde ilk değeri göster
        document.addEventListener('DOMContentLoaded', function() {
            const slider = document.getElementById('scoreSlider');
            updateScore(slider.value);
        });
    </script>
</body>
</html>