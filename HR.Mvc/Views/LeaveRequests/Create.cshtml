@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni İzin Talebi Oluştur</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .create-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .back-button {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            color: #4a5568;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

            .back-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                color: #11998e;
            }

        .form-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 40px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .form-title {
            font-size: 2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .form-subtitle {
            color: #718096;
            font-size: 1rem;
        }

        .employee-info {
            background: linear-gradient(135deg, #e0f2fe 0%, #d1fae5 100%);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
            border-left: 5px solid #11998e;
        }

            .employee-info h3 {
                font-size: 1.2rem;
                font-weight: 600;
                color: #2d3748;
                margin-bottom: 10px;
            }

        .employee-meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            color: #4a5568;
            font-size: 0.95rem;
        }

            .employee-meta span {
                display: flex;
                align-items: center;
                gap: 6px;
            }

        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #38ef7d;
        }

        .section-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: white;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2d3748;
            margin: 0;
        }

        .form-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .form-label i {
                color: #11998e;
            }

        .required {
            color: #fc5c65;
        }

        .form-control, .form-select {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #11998e;
                box-shadow: 0 0 0 3px rgba(17, 153, 142, 0.1);
                outline: none;
            }

        .leave-type-option {
            padding: 20px;
            border: 2px solid #e2e8f0;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .leave-type-option:hover {
                border-color: #11998e;
                background: #f0fdf4;
                transform: translateY(-2px);
            }

            .leave-type-option input[type="radio"] {
                width: 20px;
                height: 20px;
                cursor: pointer;
            }

                .leave-type-option input[type="radio"]:checked + .leave-type-content {
                    color: #11998e;
                }

        .leave-type-content {
            flex: 1;
        }

        .leave-type-name {
            font-weight: 600;
            font-size: 1.1rem;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .leave-type-days {
            color: #718096;
            font-size: 0.9rem;
        }

        .date-info {
            background: #f7fafc;
            padding: 15px;
            border-radius: 12px;
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #4a5568;
            font-size: 0.9rem;
        }

        .btn-submit {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 14px 40px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(56, 239, 125, 0.4);
            }

        .btn-cancel {
            background: white;
            color: #4a5568;
            padding: 14px 40px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-cancel:hover {
                border-color: #cbd5e0;
                transform: translateY(-2px);
            }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 15px 20px;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .form-card {
                padding: 25px;
            }

            .form-title {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="create-container">
        <a href="@Url.Action("Index", "Employee")" class="back-button">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>

        <div class="form-card">
            <div class="form-header">
                <h1 class="form-title">
                    <i class="fas fa-calendar-plus"></i> Yeni İzin Talebi
                </h1>
                <p class="form-subtitle">İzin talebinizi oluşturun</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Hata!</strong> @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Başarılı!</strong> @TempData["SuccessMessage"]
                </div>
            }

            <!-- Çalışan Bilgisi -->
            @if (ViewBag.Employee != null)
            {
                var employee = ViewBag.Employee;
                <div class="employee-info">
                    <h3><i class="fas fa-user"></i> @employee.FirstName @employee.LastName</h3>
                    <div class="employee-meta">
                        <span><i class="fas fa-id-badge"></i> ID: @employee.EmployeeId</span>
                        <span><i class="fas fa-building"></i> @(employee.Department?.DepartmentName ?? "N/A")</span>
                        <span><i class="fas fa-briefcase"></i> @(employee.Job?.JobTitle ?? "N/A")</span>
                    </div>
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- İzin Türü Seçimi -->
                <div class="section-header">
                    <div class="section-icon">
                        <i class="fas fa-tag"></i>
                    </div>
                    <h3 class="section-title">İzin Türü Seçin</h3>
                </div>

                @if (ViewBag.LeaveTypes != null)
                {
                    @foreach (var leaveType in ViewBag.LeaveTypes)
                    {
                        <label class="leave-type-option">
                            <input type="radio" name="leaveTypeId" value="@leaveType.LeaveTypeId" required />
                            <div class="leave-type-content">
                                <div class="leave-type-name">@leaveType.TypeName</div>
                                @if (leaveType.DaysAllowed != null)
                                {
                                    <div class="leave-type-days">
                                        <i class="fas fa-calendar-day"></i> Yıllık Hak: @leaveType.DaysAllowed gün
                                    </div>
                                }
                            </div>
                        </label>
                    }
                }

                <!-- Tarih Bilgileri -->
                <div class="section-header mt-4">
                    <div class="section-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <h3 class="section-title">İzin Tarihleri</h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fas fa-calendar-plus"></i> Başlangıç Tarihi <span class="required">*</span>
                        </label>
                        <input type="date" name="startDate" id="startDate" class="form-control" required
                               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="fas fa-calendar-minus"></i> Bitiş Tarihi <span class="required">*</span>
                        </label>
                        <input type="date" name="endDate" id="endDate" class="form-control" required
                               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-12">
                        <div class="date-info" id="dateInfo" style="display: none;">
                            <i class="fas fa-info-circle"></i>
                            <span id="dateDuration"></span>
                        </div>
                    </div>
                </div>

                <!-- İzin Nedeni -->
                <div class="section-header mt-4">
                    <div class="section-icon">
                        <i class="fas fa-comment-alt"></i>
                    </div>
                    <h3 class="section-title">İzin Nedeni</h3>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        <i class="fas fa-edit"></i> Açıklama (Opsiyonel)
                    </label>
                    <textarea name="reason" class="form-control" rows="4"
                              placeholder="İzin talebinizin nedenini kısaca açıklayın..."></textarea>
                </div>

                <!-- Bilgilendirme -->
                <div class="alert" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); color: #1e40af;">
                    <strong><i class="fas fa-lightbulb me-2"></i>Bilgi:</strong>
                    <ul class="mb-0 mt-2">
                        <li>İzin talebiniz yöneticiniz tarafından onaylanacaktır</li>
                        <li>Talebin durumunu "İzin Taleplerim" bölümünden takip edebilirsiniz</li>
                        <li>Onaylanan izinler için bildirim alacaksınız</li>
                    </ul>
                </div>

                <!-- Form Actions -->
                <div class="d-flex gap-3 justify-content-end mt-4">
                    <a href="@Url.Action("Index", "Employee")" class="btn-cancel">
                        <i class="fas fa-times"></i> İptal
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-paper-plane"></i> Talebi Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tarih hesaplama
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const dateInfo = document.getElementById('dateInfo');
        const dateDuration = document.getElementById('dateDuration');

        function calculateDays() {
            const startDate = new Date(startDateInput.value);
            const endDate = new Date(endDateInput.value);

            if (startDate && endDate && startDate <= endDate) {
                const diffTime = Math.abs(endDate - startDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

                dateInfo.style.display = 'flex';
                dateDuration.textContent = `Toplam ${diffDays} gün izin talep ediyorsunuz`;
            } else {
                dateInfo.style.display = 'none';
            }
        }

        startDateInput.addEventListener('change', calculateDays);
        endDateInput.addEventListener('change', calculateDays);

        // Bitiş tarihi minimum değeri
        startDateInput.addEventListener('change', function() {
            endDateInput.min = this.value;
        });

        // Form validasyonu
        document.querySelector('form').addEventListener('submit', function(e) {
            const startDate = new Date(startDateInput.value);
            const endDate = new Date(endDateInput.value);

            if (startDate > endDate) {
                e.preventDefault();
                alert('Bitiş tarihi, başlangıç tarihinden sonra olmalıdır!');
                return false;
            }

            const leaveTypeSelected = document.querySelector('input[name="leaveTypeId"]:checked');
            if (!leaveTypeSelected) {
                e.preventDefault();
                alert('Lütfen bir izin türü seçin!');
                return false;
            }
        });
    </script>
</body>
</html>
