@model List<HRDms.Data.Models.Department>
@{
    Layout = null;
    var userRole = Context.Session.GetString("UserRole");
    var isHRorAdmin = userRole == "HR" || userRole == "Admin";
    var isDeptManager = userRole == "DepartmentManager" || userRole == "DepManager";
}
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Departman Yönetimi</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container-custom {
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-subtitle {
            color: #718096;
            font-size: 1.1rem;
            margin-bottom: 20px;
        }

        .header-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-add {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 14px 28px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(56, 239, 125, 0.4);
            color: white;
        }

        .btn-back {
            background: white;
            color: #4a5568;
            padding: 14px 28px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .btn-back:hover {
            border-color: #cbd5e0;
            transform: translateY(-2px);
            color: #667eea;
        }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 15px 20px;
            margin-bottom: 20px;
            animation: slideDown 0.3s ease;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .departments-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 25px;
        }

        .department-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            border-top: 5px solid;
            position: relative;
            overflow: hidden;
        }

        .department-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
            border-radius: 50%;
            transform: translate(50%, -50%);
        }

        .department-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        }

        .department-card:nth-child(4n+1) {
            border-color: #667eea;
        }

        .department-card:nth-child(4n+2) {
            border-color: #38ef7d;
        }

        .department-card:nth-child(4n+3) {
            border-color: #fa709a;
        }

        .department-card:nth-child(4n+4) {
            border-color: #4facfe;
        }

        .department-header {
            display: flex;
            align-items: start;
            gap: 20px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .department-icon {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            flex-shrink: 0;
        }

        .department-info {
            flex: 1;
        }

        .department-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 8px;
        }

        .department-location {
            color: #718096;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .department-details {
            padding: 20px;
            background: #f7fafc;
            border-radius: 15px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: #718096;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .detail-value {
            color: #2d3748;
            font-weight: 600;
        }

        .manager-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 8px 15px;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .department-actions {
            display: flex;
            gap: 10px;
            position: relative;
            z-index: 1;
        }

        .btn-action {
            flex: 1;
            padding: 12px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-view {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .btn-edit {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 172, 254, 0.4);
            color: white;
        }

        .btn-delete {
            background: white;
            border: 2px solid #fc5c65;
            color: #fc5c65;
        }

        .btn-delete:hover {
            background: #fc5c65;
            color: white;
            transform: translateY(-2px);
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 20px;
            color: #a0aec0;
        }

        .empty-state i {
            font-size: 5rem;
            margin-bottom: 25px;
        }

        .empty-state h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: #718096;
        }

        @@media (max-width: 768px) {
            .page-title {
                font-size: 2rem;
            }

            .departments-grid {
                grid-template-columns: 1fr;
            }

            .header-actions {
                flex-direction: column;
            }

            .search-box {
                max-width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="container-custom">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-building"></i>
                @if (isDeptManager)
                {
                <span>Departmanlarım</span>
                }
                else
                {
                <span>Departman Yönetimi</span>
                }
            </h1>
            <p class="page-subtitle">
                @if (isDeptManager)
                {
                <span>Yöneticisi olduğunuz departmanları görüntüleyin ve düzenleyin</span>
                }
                else
                {
                <span>Şirket departmanlarını görüntüleyin ve yönetin</span>
                }
            </p>

            @if (TempData["ErrorMessage"] != null)
            {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Hata!</strong> @TempData["ErrorMessage"]
            </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>
                <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            </div>
            }

            <div class="header-actions">
                @if (isHRorAdmin)
                {
                <a href="@Url.Action("Create")" class="btn-add">
                    <i class="fas fa-plus"></i> Yeni Departman Ekle
                </a>
                <a href="@Url.Action("Index", "HR")" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Ana Sayfa
                </a>
                }
                else if (isDeptManager)
                {
                    <!-- Çalışan Profilime Git Butonu -->
                    <a href="@Url.Action("Index", "Employee")" class="btn-back" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; border: none;">
                        <i class="fas fa-user-circle"></i> Çalışan Profilime Git
                    </a>
                    
                    <!-- Çıkış Yap Butonu -->
                    <a href="@Url.Action("Logout", "Login")" class="btn-back">
                        <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                    </a>
                }
            </div>
        </div>

        @if (Model.Any())
        {
        <div class="departments-grid">
            @foreach (var dept in Model)
            {
            var iconIndex = (dept.DepartmentId % 4) + 1;
            var iconColor = iconIndex == 1 ? "#667eea, #764ba2" : iconIndex == 2 ? "#11998e, #38ef7d" : iconIndex == 3 ?
            "#fa709a, #fee140" : "#4facfe, #00f2fe";

            <div class="department-card">
                <div class="department-header">
                    <div class="department-icon" style="background: linear-gradient(135deg, @iconColor);">
                        <i class="fas fa-@(iconIndex == 1 ? "building" : iconIndex == 2 ? "cogs" : iconIndex == 3 ? "users" : "chart-line")"></i>
                    </div>
                    <div class="department-info">
                        <h3 class="department-name">@dept.DepartmentName</h3>
                        @if (dept.Location != null)
                        {
                        <div class="department-location">
                            <i class="fas fa-map-marker-alt"></i>
                            @dept.Location.LocationName
                        </div>
                        }
                    </div>
                </div>

                <div class="department-details">
                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-users"></i> Çalışan Sayısı
                        </div>
                        <div class="detail-value">@dept.Employees.Count</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-user-tie"></i> Departman Yöneticisi
                        </div>
                        <div class="detail-value">
                            @if (dept.Manager != null)
                            {
                            <span class="manager-badge">
                                <i class="fas fa-user-shield"></i>
                                @dept.Manager.FirstName @dept.Manager.LastName
                            </span>
                            }
                            else
                            {
                            <span style="color: #cbd5e0;">Atanmamış</span>
                            }
                        </div>
                    </div>

                    @if (dept.Location?.Address != null)
                    {
                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-location-dot"></i> Adres
                        </div>
                        <div class="detail-value" style="font-size: 0.85rem;">
                            @dept.Location.Address
                        </div>
                    </div>
                    }
                </div>

                <div class="department-actions">
                    <!-- Çalışanları Görüntüle Butonu -->
                    <a href="@Url.Action("Employees", new { id = dept.DepartmentId })" class="btn-action btn-view">
                        <i class="fas fa-users"></i> Çalışanları Gör (@dept.Employees.Count)
                    </a>

                    <a href="@Url.Action("Edit", new { id = dept.DepartmentId })" class="btn-action btn-edit">
                        <i class="fas fa-edit"></i> Düzenle
                    </a>
                    
                    @if (isHRorAdmin)
                    {
                        <button type="button" class="btn-action btn-delete" onclick="confirmDelete(@dept.DepartmentId, '@dept.DepartmentName')">
                            <i class="fas fa-trash"></i> Sil
                        </button>
                    }
                </div>
            </div>
            }
        </div>
        }
        else
        {
        <div class="empty-state">
            <i class="fas fa-building"></i>
            <h3>
                @if (isDeptManager)
                {
                <span>Henüz Yöneticisi Olduğunuz Departman Yok</span>
                }
                else
                {
                <span>Henüz Departman Bulunmuyor</span>
                }
            </h3>
            <p>
                @if (isHRorAdmin)
                {
                <span>Yeni bir departman eklemek için yukarıdaki butonu kullanın.</span>
                }
                else
                {
                <span>Bir departmana yönetici olarak atandığınızda burada görünecektir.</span>
                }
            </p>
        </div>
        }

        @* Eğer DepartmentManager ise, kendi profil butonu ekle *@
        @if (isDeptManager)
        {
            var sessionEmployeeId = Context.Session.GetInt32("EmployeeId");
            <div style="margin-bottom: 25px;">
                <a href="@Url.Action("Index", "Employee")" class="btn-add" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <i class="fas fa-user-circle"></i> Çalışan Profilime Git
                </a>
            </div>
        }
    </div>

    <!-- Delete Modal (Sadece HR/Admin için) -->
    @if (isHRorAdmin)
    {
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none;">
                <div class="modal-header" style="border-bottom: 1px solid #e2e8f0; padding: 20px 25px;">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>Silme Onayı
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding: 25px;">
                    <p><strong id="deptName"></strong> departmanını silmek istediğinizden emin misiniz?</p>
                    <p class="text-muted mb-0">Bu işlem geri alınamaz!</p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #e2e8f0; padding: 20px 25px;">
                    <button type="button" class="btn-action"
                        style="background: white; border: 2px solid #e2e8f0; color: #4a5568;" data-bs-dismiss="modal">
                        İptal
                    </button>
                    <form id="deleteForm" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-action"
                            style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border: none;">
                            <i class="fas fa-trash"></i> Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        @if (isHRorAdmin)
        {
        <text>
        function confirmDelete(deptId, deptName) {
            document.getElementById('deptName').textContent = deptName;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + deptId;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
        </text>
        }
    </script>
</body>

</html>