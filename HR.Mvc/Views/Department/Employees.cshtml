@model HRDms.Data.Models.Department
@{
    Layout = null;
    var userRole = Context.Session.GetString("UserRole");
    var isDeptManager = userRole == "DepartmentManager" || userRole == "DepManager";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.DepartmentName - Çalışanlar</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container-custom {
            max-width: 1400px;
            margin: 0 auto;
        }

        .back-button {
            background: rgba(255, 255, 255, 0.95);
            padding: 12px 24px;
            border-radius: 12px;
            color: #4a5568;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

            .back-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                color: #667eea;
            }

        .page-header {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dept-title {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .dept-info {
            color: #718096;
            font-size: 1.1rem;
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .employees-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .employee-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            border-left: 5px solid;
        }

            .employee-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
            }

            .employee-card:nth-child(4n+1) {
                border-color: #667eea;
            }

            .employee-card:nth-child(4n+2) {
                border-color: #38ef7d;
            }

            .employee-card:nth-child(4n+3) {
                border-color: #fa709a;
            }

            .employee-card:nth-child(4n+4) {
                border-color: #4facfe;
            }

        .employee-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .employee-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            font-weight: 700;
            flex-shrink: 0;
        }

        .employee-info {
            flex: 1;
        }

        .employee-name {
            font-size: 1.2rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .employee-job {
            color: #718096;
            font-size: 0.9rem;
        }

        .employee-details {
            padding: 15px;
            background: #f7fafc;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #e2e8f0;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

            .detail-item i {
                color: #667eea;
                width: 20px;
            }

        .detail-label {
            color: #718096;
            font-size: 0.85rem;
            flex: 1;
        }

        .detail-value {
            color: #2d3748;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .status-active {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
        }

        .status-inactive {
            background: #e2e8f0;
            color: #718096;
        }

        .btn-view-profile {
            width: 100%;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 12px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

            .btn-view-profile:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(79, 172, 254, 0.4);
                color: white;
            }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 20px;
            color: #a0aec0;
        }

            .empty-state i {
                font-size: 5rem;
                margin-bottom: 25px;
            }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 15px 20px;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .employees-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <a href="@Url.Action("Index")" class="back-button">
            <i class="fas fa-arrow-left"></i> Departmanlara Dön
        </a>

        <div class="page-header">
            <h1 class="dept-title">
                <i class="fas fa-building"></i> @Model.DepartmentName
            </h1>
            <div class="dept-info">
                <span><i class="fas fa-users"></i> <strong>@Model.Employees.Count</strong> Çalışan</span>
                @if (Model.Location != null)
                {
                    <span><i class="fas fa-map-marker-alt"></i> @Model.Location.LocationName</span>
                }
                @if (Model.Manager != null)
                {
                    <span><i class="fas fa-user-tie"></i> Yönetici: <strong>@Model.Manager.FirstName @Model.Manager.LastName</strong></span>
                }
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Hata!</strong> @TempData["ErrorMessage"]
                </div>
            }
        </div>

        @if (Model.Employees.Any())
        {
            <div class="employees-grid">
                @foreach (var employee in Model.Employees.OrderBy(e => e.FirstName))
                {
                    var contract = employee.EmploymentContracts?.FirstOrDefault();

                    <div class="employee-card">
                        <div class="employee-header">
                            <div class="employee-avatar">
                                @(employee.FirstName?.Substring(0, 1).ToUpper())@(employee.LastName?.Substring(0, 1).ToUpper())
                            </div>
                            <div class="employee-info">
                                <div class="employee-name">@employee.FirstName @employee.LastName</div>
                                <div class="employee-job">@(employee.Job?.JobTitle ?? "Pozisyon Belirtilmemiş")</div>
                            </div>
                        </div>

                        <div class="employee-details">
                            <div class="detail-item">
                                <i class="fas fa-id-badge"></i>
                                <span class="detail-label">Çalışan ID</span>
                                <span class="detail-value">#@employee.EmployeeId</span>
                            </div>

                            @if (!string.IsNullOrEmpty(employee.Email))
                            {
                                <div class="detail-item">
                                    <i class="fas fa-envelope"></i>
                                    <span class="detail-label">E-posta</span>
                                    <span class="detail-value" style="font-size: 0.8rem;">@employee.Email</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(employee.PhoneNumber))
                            {
                                <div class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    <span class="detail-label">Telefon</span>
                                    <span class="detail-value">@employee.PhoneNumber</span>
                                </div>
                            }

                            @if (employee.HireDate != null)
                            {
                                <div class="detail-item">
                                    <i class="fas fa-calendar"></i>
                                    <span class="detail-label">İşe Giriş</span>
                                    <span class="detail-value">@employee.HireDate.Value.ToString("dd.MM.yyyy")</span>
                                </div>
                            }

                            @if (contract != null)
                            {
                                <div class="detail-item">
                                    <i class="fas fa-file-contract"></i>
                                    <span class="detail-label">Sözleşme</span>
                                    <span class="detail-value">@contract.ContractType</span>
                                </div>
                            }

                            <div class="detail-item">
                                <i class="fas fa-toggle-on"></i>
                                <span class="detail-label">Durum</span>
                                <span class="detail-value">
                                    @if (employee.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i> Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="fas fa-times-circle"></i> Pasif
                                        </span>
                                    }
                                </span>
                            </div>
                        </div>

                        <a href="@Url.Action("Details", "Employee", new { id = employee.EmployeeId })" class="btn-view-profile">
                            <i class="fas fa-eye"></i> Profili Görüntüle
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                <h3>Bu Departmanda Çalışan Bulunmuyor</h3>
                <p>Henüz bu departmana atanmış çalışan yok.</p>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
