@model HRDms.Data.Models.Employee
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Çalışan Düzenle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .edit-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .back-button {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            color: #4a5568;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

            .back-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                color: #667eea;
            }

        .form-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 40px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .form-title {
            font-size: 2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .form-subtitle {
            color: #718096;
            font-size: 1rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid;
        }

            .section-header.personal {
                border-color: #667eea;
            }

            .section-header.work {
                border-color: #38ef7d;
            }

        .section-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: white;
        }

        .section-header.personal .section-icon {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .section-header.work .section-icon {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2d3748;
            margin: 0;
        }

        .form-section {
            margin-bottom: 35px;
        }

        .form-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .form-label i {
                color: #a0aec0;
            }

        .required {
            color: #fc5c65;
        }

        .form-control, .form-select {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                outline: none;
            }

        .form-check {
            padding: 15px;
            background: #f7fafc;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            transition: all 0.3s ease;
        }

            .form-check:hover {
                border-color: #667eea;
                background: #f0f4ff;
            }

        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }

        .form-check-label {
            font-weight: 500;
            color: #2d3748;
            cursor: pointer;
        }

        .btn-submit {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 14px 40px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            }

        .btn-cancel {
            background: white;
            color: #4a5568;
            padding: 14px 40px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-cancel:hover {
                border-color: #cbd5e0;
                transform: translateY(-2px);
            }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 15px 20px;
            margin-bottom: 20px;
        }

        .employee-id-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        @@media (max-width: 768px) {
            .form-card {
                padding: 25px;
            }

            .form-title {
                font-size: 1.5rem;
            }

            .section-title {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <div class="edit-container">
        <a href="@Url.Action("Index", "HR")" class="back-button">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>

        <div class="form-card">
            <div class="form-header">
                <h1 class="form-title">
                    <i class="fas fa-user-edit"></i> Çalışan Bilgilerini Düzenle
                </h1>
                <p class="form-subtitle">
                    <span class="employee-id-badge">
                        <i class="fas fa-id-badge"></i> ID: @Model.EmployeeId
                    </span>
                </p>
            </div>

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Hata!</strong> Lütfen formu kontrol edin.
                    
                    @if (ViewBag.ValidationErrors != null)
                    {
                        <ul class="mt-2 mb-0">
                            @foreach (var error in ViewBag.ValidationErrors)
                            {
                                <li><strong>@error.Field:</strong> @string.Join(", ", error.Errors)</li>
                            }
                        </ul>
                    }
                    
                    @Html.ValidationSummary(false, "", new { @class = "mb-0 mt-2" })
                </div>
            }

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.EmployeeId)
                @Html.HiddenFor(m => m.UserId)

                <!-- Personal Information Section -->
                <div class="form-section">
                    <div class="section-header personal">
                        <div class="section-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <h3 class="section-title">Kişisel Bilgiler</h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-user"></i> Ad <span class="required">*</span>
                            </label>
                            <input asp-for="FirstName" class="form-control" placeholder="Adınızı girin" required />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-user"></i> Soyad <span class="required">*</span>
                            </label>
                            <input asp-for="LastName" class="form-control" placeholder="Soyadınızı girin" required />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-id-card"></i> TC Kimlik No <span class="required">*</span>
                            </label>
                            <input asp-for="IdentityNumber" class="form-control" placeholder="11 haneli TC kimlik numarası" maxlength="11" required />
                            <span asp-validation-for="IdentityNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-envelope"></i> E-posta <span class="required">*</span>
                            </label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ornek@email.com" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-phone"></i> Telefon
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+90 (5XX) XXX XX XX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Work Information Section -->
                <div class="form-section">
                    <div class="section-header work">
                        <div class="section-icon">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <h3 class="section-title">İş Bilgileri</h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-calendar-alt"></i> İşe Giriş Tarihi <span class="required">*</span>
                            </label>
                            <input asp-for="HireDate" type="date" class="form-control" required />
                            <span asp-validation-for="HireDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-building"></i> Departman <span class="required">*</span>
                            </label>
                            @{
                                var isDepartmentManager = ViewBag.IsDepartmentManager as bool? ?? false;
                            }

                            @if (isDepartmentManager)
                            {
                                <select asp-for="DepartmentId"
                                        asp-items="@((List<SelectListItem>)ViewBag.Departments)"
                                        class="form-select"
                                        disabled="disabled">
                                    <option value="">Departman Seçin</option>
                                </select>
                                @Html.HiddenFor(m => m.DepartmentId)
                                <small class="text-muted">
                                    <i class="fas fa-info-circle"></i>
                                    Bu çalışan bir departman yöneticisi olduğu için departmanı değiştirilemez.
                                </small>
                            }
                            else
                            {
                                <select asp-for="DepartmentId"
                                        asp-items="@((List<SelectListItem>)ViewBag.Departments)"
                                        class="form-select">
                                    <option value="">Departman Seçin</option>
                                </select>
                            }

                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-user-tie"></i> Pozisyon <span class="required">*</span>
                            </label>
                            <select asp-for="JobId" asp-items="@((List<SelectListItem>)ViewBag.Jobs)" class="form-select" required>
                                <option value="">Pozisyon Seçin</option>
                            </select>
                            <span asp-validation-for="JobId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="fas fa-user-shield"></i> Yönetici
                            </label>
                            <select asp-for="ManagerId" asp-items="@((List<SelectListItem>)ViewBag.Managers)" class="form-select">
                                <option value="">Yönetici Seçin (Opsiyonel)</option>
                            </select>
                            <span asp-validation-for="ManagerId" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" asp-for="IsActive">
                                    <i class="fas fa-check-circle text-success me-1"></i> Aktif Çalışan
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Employment Contract Section -->
                @if (ViewBag.ActiveContract != null)
                {
                    var contract = (HRDms.Data.Models.EmploymentContract)ViewBag.ActiveContract;
                    
                    <div class="form-section">
                        <div class="section-header" style="border-color: #4facfe;">
                            <div class="section-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <h3 class="section-title">İş Sözleşmesi Düzenleme</h3>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="updateContractCheck" name="updateContract" value="true">
                            <label class="form-check-label" for="updateContractCheck">
                                <i class="fas fa-edit text-info me-1"></i> Sözleşme bilgilerini güncelle
                            </label>
                        </div>

                        <div class="user-section" id="contractSection" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border: 2px solid #bfdbfe;">
                            <input type="hidden" name="contractId" value="@contract.ContractId" />
                            
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Mevcut sözleşme bilgileri güncellenecektir. Checkbox'ı işaretleyerek değişiklikleri kaydedin.
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        <i class="fas fa-calendar-plus"></i> Sözleşme Başlangıç Tarihi <span class="required">*</span>
                                    </label>
                                    <input type="date" name="contractStartDate" id="contractStartDate" class="form-control" value="@contract.StartDate.ToString("yyyy-MM-dd")" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        <i class="fas fa-calendar-minus"></i> Sözleşme Bitiş Tarihi
                                    </label>
                                    <input type="date" name="contractEndDate" id="contractEndDate" class="form-control" value="@(contract.EndDate?.ToString("yyyy-MM-dd"))" />
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Belirsiz süreli sözleşme için boş bırakabilirsiniz
                                    </small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        <i class="fas fa-money-bill-wave"></i> Maaş (TL) <span class="required">*</span>
                                    </label>
                                    <input type="number" name="contractSalary" id="contractSalary" class="form-control" placeholder="Örn: 15000" step="0.01" min="0" value="@contract.Salary" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        <i class="fas fa-file-alt"></i> Sözleşme Türü
                                    </label>
                                    <select name="contractType" id="contractType" class="form-select">
                                        <option value="Belirsiz Süreli" selected="@(contract.ContractType == "Belirsiz Süreli")">Belirsiz Süreli</option>
                                        <option value="Belirli Süreli" selected="@(contract.ContractType == "Belirli Süreli")">Belirli Süreli</option>
                                        <option value="Kısmi Zamanlı" selected="@(contract.ContractType == "Kısmi Zamanlı")">Kısmi Zamanlı</option>
                                        <option value="Proje Bazlı" selected="@(contract.ContractType == "Proje Bazlı")">Proje Bazlı</option>
                                        <option value="Stajyer" selected="@(contract.ContractType == "Stajyer")">Stajyer</option>
                                    </select>
                                </div>

                                <div class="col-12">
                                    <div class="alert" style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-left: 4px solid #4facfe; color: #1e40af;">
                                        <strong><i class="fas fa-chart-line me-2"></i>Mevcut Sözleşme Bilgileri:</strong>
                                        <ul class="mb-0 mt-2" style="font-size: 0.9rem;">
                                            <li>Sözleşme ID: <strong>#@contract.ContractId</strong></li>
                                            <li>Sözleşme Türü: <strong>@contract.ContractType</strong></li>
                                            <li>Mevcut Maaş: <strong>@contract.Salary.ToString("N2") TL</strong></li>
                                            <li>Başlangıç: <strong>@contract.StartDate.ToString("dd MMMM yyyy")</strong></li>
                                            <li>Bitiş: <strong>@(contract.EndDate?.ToString("dd MMMM yyyy") ?? "Belirsiz Süreli")</strong></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Sözleşme Yoksa Bilgilendirme -->
                    <div class="form-section">
                        <div class="section-header" style="border-color: #cbd5e0;">
                            <div class="section-icon" style="background: linear-gradient(135deg, #cbd5e0 0%, #a0aec0 100%);">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <h3 class="section-title">İş Sözleşmesi</h3>
                        </div>

                        <div class="alert" style="background: #f7fafc; border-left: 4px solid #cbd5e0; color: #4a5568;">
                            <i class="fas fa-info-circle me-2"></i>
                            Bu çalışan için aktif bir iş sözleşmesi bulunmamaktadır. Yeni sözleşme oluşturmak için çalışan detay sayfasını ziyaret edin.
                        </div>
                    </div>
                }

                <!-- Form Actions -->
                <div class="d-flex gap-3 justify-content-end mt-4">
                    <a href="@Url.Action("Index", "HR")" class="btn-cancel">
                        <i class="fas fa-times"></i> İptal
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Contract section toggle
        document.getElementById('updateContractCheck')?.addEventListener('change', function() {
            const contractSection = document.getElementById('contractSection');
            const startDateInput = document.getElementById('contractStartDate');
            const salaryInput = document.getElementById('contractSalary');

            if (this.checked) {
                contractSection.classList.add('active');
                startDateInput.required = true;
                salaryInput.required = true;
            } else {
                contractSection.classList.remove('active');
                startDateInput.required = false;
                salaryInput.required = false;
            }
        });
    </script>
</body>
</html>
