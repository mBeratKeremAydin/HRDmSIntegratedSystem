@model HRDms.Data.Models.Employee
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Performans Değerlendirmeleri - @Model.FirstName @Model.LastName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container-custom {
            max-width: 1200px;
            margin: 0 auto;
        }

        .back-button {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            color: #4a5568;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

            .back-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                color: #fa709a;
            }

        .header-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-content {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .employee-avatar {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            font-weight: 700;
            flex-shrink: 0;
        }

        .employee-info {
            flex: 1;
        }

        .employee-name {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .employee-details {
            color: #718096;
            font-size: 1rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            animation: fadeInUp 0.6s ease;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            margin-bottom: 15px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #718096;
            font-size: 0.9rem;
        }

        .performance-grid {
            display: grid;
            gap: 20px;
        }

        .performance-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            border-left: 5px solid;
        }

            .performance-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
            }

            .performance-card.excellent {
                border-color: #38ef7d;
            }

            .performance-card.good {
                border-color: #4facfe;
            }

            .performance-card.average {
                border-color: #fee140;
            }

            .performance-card.poor {
                border-color: #f5576c;
            }

        .performance-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .review-date {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #718096;
            font-weight: 500;
        }

        .score-badge {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
            color: white;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        }

            .score-badge.excellent {
                background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            }

            .score-badge.good {
                background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            }

            .score-badge.average {
                background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            }

            .score-badge.poor {
                background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            }

        .score-details {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .score-info {
            flex: 1;
        }

        .score-title {
            font-size: 0.9rem;
            color: #718096;
            margin-bottom: 5px;
        }

        .score-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #2d3748;
        }

        .score-bar {
            flex: 1;
        }

        .progress-bar-custom {
            height: 12px;
            background: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 8px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 1s ease;
        }

        .reviewer-info {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: #f7fafc;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .reviewer-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
            font-weight: 600;
            flex-shrink: 0;
        }

        .reviewer-details {
            flex: 1;
        }

        .reviewer-name {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 3px;
        }

        .reviewer-role {
            font-size: 0.85rem;
            color: #718096;
        }

        .notes-section {
            padding: 20px;
            background: #f7fafc;
            border-radius: 12px;
            border-left: 4px solid #fa709a;
        }

        .notes-label {
            font-size: 0.9rem;
            color: #718096;
            margin-bottom: 10px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .notes-text {
            color: #2d3748;
            line-height: 1.7;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 20px;
            color: #a0aec0;
        }

            .empty-state i {
                font-size: 4rem;
                margin-bottom: 20px;
            }

            .empty-state h3 {
                font-size: 1.5rem;
                margin-bottom: 10px;
                color: #718096;
            }

        @@media (max-width: 768px) {
            .employee-name {
                font-size: 1.5rem;
            }

            .score-details {
                flex-direction: column;
            }

            .performance-header {
                flex-direction: column;
                align-items: start;
            }
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <a href="@Url.Action("Index", "HR", new { id = Model.EmployeeId })" class="back-button">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>

        <div class="header-card">
            <div class="header-content">
                <div class="employee-avatar">
                    @(Model.FirstName?.Substring(0, 1).ToUpper())@(Model.LastName?.Substring(0, 1).ToUpper())
                </div>
                <div class="employee-info">
                    <div class="employee-name">@Model.FirstName @Model.LastName</div>
                    <div class="employee-details">
                        <i class="fas fa-id-badge"></i> ID: @Model.EmployeeId &nbsp;|&nbsp;
                        <i class="fas fa-briefcase"></i> @(Model.Job?.JobTitle ?? "Pozisyon Belirtilmemiş")
                    </div>
                </div>
            </div>
        </div>

        @{
            var reviews = Model.PerformanceReviewEmployees?.OrderByDescending(r => r.ReviewDate).ToList() ?? new List<HRDms.Data.Models.PerformanceReview>();
            var totalReviews = reviews.Count;
            var avgScore = reviews.Any() ? reviews.Average(r => r.Score) : 0;
            var lastReview = reviews.FirstOrDefault();
            var trend = reviews.Count >= 2 ? reviews[0].Score - reviews[1].Score : 0;
        }

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-value">@totalReviews</div>
                <div class="stat-label">Toplam Değerlendirme</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-value">@avgScore.ToString("F1")</div>
                <div class="stat-label">Ortalama Puan</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <i class="fas fa-trophy"></i>
                </div>
                <div class="stat-value">@(lastReview?.Score.ToString() ?? "N/A")</div>
                <div class="stat-label">Son Puan</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-@(trend > 0 ? "arrow-up" : trend < 0 ? "arrow-down" : "minus")"></i>
                </div>
                <div class="stat-value" style="color: @(trend > 0 ? "#38ef7d" : trend < 0 ? "#f5576c" : "#718096");">
                    @(trend > 0 ? "+" : "")@trend
                </div>
                <div class="stat-label">Trend</div>
            </div>
        </div>

        @if (reviews.Any())
        {
            <div class="performance-grid">
                @foreach (var review in reviews)
                {
                    var scoreClass = review.Score >= 85 ? "excellent" : review.Score >= 70 ? "good" : review.Score >= 50 ? "average" : "poor";
                    var scoreLabel = review.Score >= 85 ? "Mükemmel" : review.Score >= 70 ? "İyi" : review.Score >= 50 ? "Orta" : "Geliştirilmeli";
                    var scorePercent = review.Score;

                    <div class="performance-card @scoreClass">
                        <div class="performance-header">
                            <div class="review-date">
                                <i class="fas fa-calendar-alt"></i>
                                @(review.ReviewDate?.ToString("dd MMMM yyyy") ?? "Tarih Belirtilmemiş")
                            </div>
                        </div>

                        <div class="score-details">
                            <div class="score-badge @scoreClass">
                                @review.Score
                            </div>

                            <div class="score-info">
                                <div class="score-title">Performans Puanı</div>
                                <div class="score-value">@scoreLabel</div>
                                <div class="progress-bar-custom">
                                    <div class="progress-fill" style="width: @scorePercent%; background: linear-gradient(135deg, @(scoreClass == "excellent" ? "#11998e, #38ef7d" : scoreClass == "good" ? "#4facfe, #00f2fe" : scoreClass == "average" ? "#fa709a, #fee140" : "#f093fb, #f5576c"));">
                                    </div>
                                </div>
                                <small style="color: #718096;">100 üzerinden @review.Score puan</small>
                            </div>
                        </div>

                        @if (review.Reviewer != null)
                        {
                            <div class="reviewer-info">
                                <div class="reviewer-avatar">
                                    @(review.Reviewer.FirstName?.Substring(0, 1).ToUpper())@(review.Reviewer.LastName?.Substring(0, 1).ToUpper())
                                </div>
                                <div class="reviewer-details">
                                    <div class="reviewer-name">
                                        <i class="fas fa-user-tie"></i> @review.Reviewer.FirstName @review.Reviewer.LastName
                                    </div>
                                    <div class="reviewer-role">Değerlendiren: @(review.Reviewer.Job?.JobTitle ?? "Yönetici")</div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(review.Notes))
                        {
                            <div class="notes-section">
                                <div class="notes-label">
                                    <i class="fas fa-comment-alt"></i> Değerlendirme Notları
                                </div>
                                <div class="notes-text">@review.Notes</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-chart-line"></i>
                <h3>Performans Değerlendirmesi Bulunamadı</h3>
                <p>Bu çalışan için henüz performans değerlendirmesi yapılmamıştır.</p>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
