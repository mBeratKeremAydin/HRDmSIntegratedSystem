@model HRDms.Data.Models.Employee
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>İzin Talepleri - @Model.FirstName @Model.LastName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container-custom {
            max-width: 1200px;
            margin: 0 auto;
        }

        .back-button {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            color: #4a5568;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

            .back-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                color: #11998e;
            }

        .header-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-content {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .employee-avatar {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            font-weight: 700;
            flex-shrink: 0;
        }

        .employee-info {
            flex: 1;
        }

        .employee-name {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .employee-details {
            color: #718096;
            font-size: 1rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            animation: fadeInUp 0.6s ease;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            margin-bottom: 15px;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #718096;
            font-size: 0.9rem;
        }

        .leaves-grid {
            display: grid;
            gap: 20px;
        }

        .leave-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
        }

            .leave-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
            }

        .leave-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .leave-type {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2d3748;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .leave-type-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
        }

        .badge-status {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-pending {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            color: white;
        }

        .badge-approved {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
        }

        .badge-rejected {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }

        .leave-dates {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }

        .date-box {
            padding: 15px;
            background: #f7fafc;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
        }

        .date-label {
            font-size: 0.85rem;
            color: #718096;
            margin-bottom: 5px;
        }

        .date-value {
            font-weight: 600;
            color: #2d3748;
            font-size: 1rem;
        }

        .leave-reason {
            padding: 15px;
            background: #f7fafc;
            border-radius: 12px;
            border-left: 4px solid #11998e;
            margin-top: 15px;
        }

        .reason-label {
            font-size: 0.85rem;
            color: #718096;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .reason-text {
            color: #2d3748;
            line-height: 1.6;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 20px;
            color: #a0aec0;
        }

            .empty-state i {
                font-size: 4rem;
                margin-bottom: 20px;
            }

            .empty-state h3 {
                font-size: 1.5rem;
                margin-bottom: 10px;
                color: #718096;
            }

        @@media (max-width: 768px) {
            .employee-name {
                font-size: 1.5rem;
            }

            .leave-header {
                flex-direction: column;
            }

            .leave-dates {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <a href="@Url.Action("Index", "HR", new { id = Model.EmployeeId })" class="back-button">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>

        <div class="header-card">
            <div class="header-content">
                <div class="employee-avatar">
                    @(Model.FirstName?.Substring(0, 1).ToUpper())@(Model.LastName?.Substring(0, 1).ToUpper())
                </div>
                <div class="employee-info">
                    <div class="employee-name">@Model.FirstName @Model.LastName</div>
                    <div class="employee-details">
                        <i class="fas fa-id-badge"></i> ID: @Model.EmployeeId &nbsp;|&nbsp;
                        <i class="fas fa-briefcase"></i> @(Model.Job?.JobTitle ?? "Pozisyon Belirtilmemiş")
                    </div>
                </div>
            </div>
        </div>

        @{
            var leaves = Model.LeaveRequests?.OrderByDescending(l => l.StartDate).ToList() ?? new List<HRDms.Data.Models.LeaveRequest>();
            var totalLeaves = leaves.Count;
            var approvedLeaves = leaves.Count(l => l.Status == "Approved");
            var pendingLeaves = leaves.Count(l => l.Status == "Pending");
            var totalDays = leaves.Where(l => l.Status == "Approved").Sum(l => l.EndDate.DayNumber - l.StartDate.DayNumber + 1);
        }

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="fas fa-list"></i>
                </div>
                <div class="stat-value">@totalLeaves</div>
                <div class="stat-label">Toplam İzin Talebi</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-value">@approvedLeaves</div>
                <div class="stat-label">Onaylanan İzinler</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-value">@pendingLeaves</div>
                <div class="stat-label">Bekleyen İzinler</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <div class="stat-value">@totalDays</div>
                <div class="stat-label">Kullanılan Gün</div>
            </div>
        </div>

        @if (leaves.Any())
        {
            <div class="leaves-grid">
                @foreach (var leave in leaves)
                {
                    var days = leave.EndDate.DayNumber - leave.StartDate.DayNumber + 1;
                    var statusClass = leave.Status == "Approved" ? "approved" : leave.Status == "Pending" ? "pending" : "rejected";
                    var statusText = leave.Status == "Approved" ? "Onaylandı" : leave.Status == "Pending" ? "Bekliyor" : "Reddedildi";
                    var statusIcon = leave.Status == "Approved" ? "check-circle" : leave.Status == "Pending" ? "clock" : "times-circle";

                    <div class="leave-card">
                        <div class="leave-header">
                            <div class="leave-type">
                                <div class="leave-type-icon" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                                    <i class="fas fa-umbrella-beach"></i>
                                </div>
                                @(leave.LeaveType?.TypeName ?? "İzin Türü Belirtilmemiş")
                            </div>
                            <span class="badge-status badge-@statusClass">
                                <i class="fas fa-@statusIcon"></i> @statusText
                            </span>
                        </div>

                        <div class="leave-dates">
                            <div class="date-box">
                                <div class="date-label">
                                    <i class="fas fa-calendar-plus"></i> Başlangıç
                                </div>
                                <div class="date-value">@leave.StartDate.ToString("dd MMM yyyy")</div>
                            </div>

                            <div class="date-box">
                                <div class="date-label">
                                    <i class="fas fa-calendar-minus"></i> Bitiş
                                </div>
                                <div class="date-value">@leave.EndDate.ToString("dd MMM yyyy")</div>
                            </div>

                            <div class="date-box">
                                <div class="date-label">
                                    <i class="fas fa-hourglass-half"></i> Süre
                                </div>
                                <div class="date-value">@days Gün</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(leave.Reason))
                        {
                            <div class="leave-reason">
                                <div class="reason-label">
                                    <i class="fas fa-comment-alt"></i> İzin Nedeni
                                </div>
                                <div class="reason-text">@leave.Reason</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-times"></i>
                <h3>İzin Talebi Bulunamadı</h3>
                <p>Bu çalışan için henüz izin talebi bulunmamaktadır.</p>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
