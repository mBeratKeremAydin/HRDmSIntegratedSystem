@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Admin Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3><i class="fas fa-crown"></i> Admin Yönetim Paneli</h3>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- HR Çalışanları -->
                    <div class="col-md-4">
                        <div class="card text-center h-100">
                            <div class="card-body">
                                <i class="fas fa-user-tie fa-3x text-primary mb-3"></i>
                                <h5>HR Çalışanları</h5>
                                <p class="text-muted">@ViewBag.TotalHREmployees Kişi</p>
                                <a href="@Url.Action("HREmployees")" class="btn btn-primary">Yönet</a>
                            </div>
                        </div>
                    </div>

                    <!-- İş Pozisyonları -->
                    <div class="col-md-4">
                        <div class="card text-center h-100">
                            <div class="card-body">
                                <i class="fas fa-briefcase fa-3x text-success mb-3"></i>
                                <h5>İş Pozisyonları</h5>
                                <p class="text-muted">@ViewBag.TotalJobs Pozisyon</p>
                                <a href="@Url.Action("Jobs")" class="btn btn-success">Yönet</a>
                            </div>
                        </div>
                    </div>

                    <!-- İzin Türleri -->
                    <div class="col-md-4">
                        <div class="card text-center h-100">
                            <div class="card-body">
                                <i class="fas fa-calendar-alt fa-3x text-warning mb-3"></i>
                                <h5>İzin Türleri</h5>
                                <p class="text-muted">@ViewBag.TotalLeaveTypes Tür</p>
                                <a href="@Url.Action("LeaveTypes")" class="btn btn-warning">Yönet</a>
                            </div>
                        </div>
                    </div>

                    <!-- Lokasyonlar -->
                    <div class="col-md-4">
                        <div class="card text-center h-100">
                            <div class="card-body">
                                <i class="fas fa-map-marker-alt fa-3x text-info mb-3"></i>
                                <h5>Lokasyonlar</h5>
                                <p class="text-muted">@ViewBag.TotalLocations Lokasyon</p>
                                <a href="@Url.Action("Locations")" class="btn btn-info">Yönet</a>
                            </div>
                        </div>
                    </div>

                    <!-- Roller -->
                    <div class="col-md-4">
                        <div class="card text-center h-100">
                            <div class="card-body">
                                <i class="fas fa-user-shield fa-3x text-danger mb-3"></i>
                                <h5>Roller</h5>
                                <p class="text-muted">@ViewBag.TotalRoles Rol</p>
                                <a href="@Url.Action("Roles")" class="btn btn-danger">Görüntüle</a>
                            </div>
                        </div>
                    </div>

                    <!-- Çıkış -->
                    <div class="col-md-4">
                        <div class="card text-center h-100">
                            <div class="card-body">
                                <i class="fas fa-sign-out-alt fa-3x text-secondary mb-3"></i>
                                <h5>Çıkış</h5>
                                <p class="text-muted">Oturumu Kapat</p>
                                <a href="@Url.Action("Logout", "Login")" class="btn btn-secondary">Çıkış Yap</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>