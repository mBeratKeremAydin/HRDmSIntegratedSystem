@{
    Layout = null;
    var username = Context.Session.GetString("Username");
    var employeeName = Context.Session.GetString("EmployeeName");
    var displayName = !string.IsNullOrEmpty(employeeName) ? employeeName : username ?? "Admin";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Yönetim Paneli</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .admin-container {
            max-width: 1600px;
            margin: 0 auto;
        }

        .admin-header {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
            animation: fadeInUp 0.6s ease;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
        }

        .admin-title {
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .admin-title h1 {
                font-size: 2.5rem;
                font-weight: 700;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin: 0;
            }

        .admin-badge {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .welcome-text {
            color: #718096;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .welcome-text strong {
                color: #2d3748;
            }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 12px 24px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-settings {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }

            .btn-settings:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(79, 172, 254, 0.4);
                color: white;
            }

        .btn-logout {
            background: linear-gradient(135deg, #fc5c65 0%, #eb3b5a 100%);
            color: white;
        }

            .btn-logout:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(252, 92, 101, 0.4);
                color: white;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            cursor: pointer;
            border-top: 5px solid;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            }

            .stat-card:nth-child(5n+1) {
                border-color: #667eea;
            }

            .stat-card:nth-child(5n+2) {
                border-color: #38ef7d;
            }

            .stat-card:nth-child(5n+3) {
                border-color: #fa709a;
            }

            .stat-card:nth-child(5n+4) {
                border-color: #4facfe;
            }

            .stat-card:nth-child(5n+5) {
                border-color: #f5576c;
            }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #718096;
            font-size: 0.95rem;
        }

        .stat-sublabel {
            color: #a0aec0;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .management-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .management-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease;
            text-decoration: none;
            border-left: 5px solid;
        }

            .management-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            }

            .management-card:nth-child(6n+1) {
                border-color: #667eea;
            }

            .management-card:nth-child(6n+2) {
                border-color: #38ef7d;
            }

            .management-card:nth-child(6n+3) {
                border-color: #fa709a;
            }

            .management-card:nth-child(6n+4) {
                border-color: #4facfe;
            }

            .management-card:nth-child(6n+5) {
                border-color: #f5576c;
            }

            .management-card:nth-child(6n+6) {
                border-color: #ff9a00;
            }

        .management-icon {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            margin-bottom: 20px;
        }

        .management-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 10px;
        }

        .management-desc {
            color: #718096;
            font-size: 0.9rem;
            margin-bottom: 15px;
        }

        .management-stats {
            display: flex;
            gap: 15px;
            padding-top: 15px;
            border-top: 1px solid #e2e8f0;
        }

        .management-stat {
            font-size: 0.85rem;
            color: #718096;
        }

            .management-stat strong {
                color: #2d3748;
                font-weight: 700;
            }

        .recent-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 25px;
        }

        .activity-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            animation: fadeInUp 0.6s ease;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .activity-item {
            padding: 15px;
            background: #f7fafc;
            border-radius: 12px;
            margin-bottom: 12px;
            transition: all 0.3s ease;
            border-left: 3px solid;
        }

            .activity-item:hover {
                transform: translateX(5px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }

            .activity-item:last-child {
                margin-bottom: 0;
            }

        .activity-title {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .activity-meta {
            color: #718096;
            font-size: 0.85rem;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #a0aec0;
        }

            .empty-state i {
                font-size: 3rem;
                margin-bottom: 15px;
            }

        @@media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .management-grid {
                grid-template-columns: 1fr;
            }

            .recent-section {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Admin Header -->
        <div class="admin-header">
            <div class="header-top">
                <div class="admin-title">
                    <h1><i class="fas fa-crown"></i> Admin Paneli</h1>
                    <span class="admin-badge">
                        <i class="fas fa-shield-alt"></i> Tam Yetki
                    </span>
                </div>
                <div class="header-actions">
                    <a href="@Url.Action("Settings")" class="btn-action btn-settings">
                        <i class="fas fa-cog"></i> Sistem Ayarları
                    </a>
                    <a href="@Url.Action("Logout", "Login")" class="btn-action btn-logout">
                        <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                    </a>
                </div>
            </div>
            <p class="welcome-text">
                <i class="fas fa-user-shield"></i>
                Hoş geldiniz, <strong>@displayName</strong> - Sistem Yöneticisi
            </p>
        </div>

        <!-- Statistics -->
        <div class="stats-grid">
            <div class="stat-card" onclick="window.location.href='@Url.Action("Employees")'">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">@ViewBag.TotalEmployees</div>
                        <div class="stat-label">Toplam Çalışan</div>
                        <div class="stat-sublabel">@ViewBag.ActiveEmployees aktif</div>
                    </div>
                    <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>

            <div class="stat-card" onclick="window.location.href='@Url.Action("Index","Departments")'">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">@ViewBag.TotalDepartments</div>
                        <div class="stat-label">Departmanlar</div>
                        <div class="stat-sublabel">Tüm departmanlar</div>
                    </div>
                    <div class="stat-icon" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                        <i class="fas fa-building"></i>
                    </div>
                </div>
            </div>

            <div class="stat-card" onclick="window.location.href='@Url.Action("Contracts")'">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">@ViewBag.TotalContracts</div>
                        <div class="stat-label">Sözleşmeler</div>
                        <div class="stat-sublabel">@ViewBag.ActiveContracts aktif</div>
                    </div>
                    <div class="stat-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                        <i class="fas fa-file-contract"></i>
                    </div>
                </div>
            </div>

            <div class="stat-card" onclick="window.location.href='@Url.Action("LeaveRequests")'">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">@ViewBag.PendingLeaves</div>
                        <div class="stat-label">Bekleyen İzinler</div>
                        <div class="stat-sublabel">Onay bekliyor</div>
                    </div>
                    <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>

            <div class="stat-card" onclick="window.location.href='@Url.Action("Jobs")'">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">@ViewBag.TotalJobs</div>
                        <div class="stat-label">İş Pozisyonları</div>
                        <div class="stat-sublabel">Tüm pozisyonlar</div>
                    </div>
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <i class="fas fa-briefcase"></i>
                    </div>
                </div>
            </div>

            <div class="stat-card" onclick="window.location.href='@Url.Action("Users")'">
                <div class="stat-header">
                    <div>
                        <div class="stat-value">@ViewBag.TotalUsers</div>
                        <div class="stat-label">Kullanıcılar</div>
                        <div class="stat-sublabel">@ViewBag.ActiveUsers aktif</div>
                    </div>
                    <div class="stat-icon" style="background: linear-gradient(135deg, #ff9a00 0%, #feca57 100%);">
                        <i class="fas fa-user-shield"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Modules -->
        <div class="management-grid">
            <a href="@Url.Action("Employees")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="fas fa-users-cog"></i>
                </div>
                <h3 class="management-title">Çalışan Yönetimi</h3>
                <p class="management-desc">Tüm çalışanları görüntüle, ekle, düzenle ve yönet</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.TotalEmployees</strong> Çalışan</span>
                    <span class="management-stat"><strong>@ViewBag.ActiveEmployees</strong> Aktif</span>
                </div>
            </a>

            <a href="@Url.Action("Departments")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <i class="fas fa-sitemap"></i>
                </div>
                <h3 class="management-title">Departman Yönetimi</h3>
                <p class="management-desc">Departmanları yönet, yönetici ata</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.TotalDepartments</strong> Departman</span>
                </div>
            </a>

            <a href="@Url.Action("Jobs")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                    <i class="fas fa-briefcase"></i>
                </div>
                <h3 class="management-title">Pozisyon Yönetimi</h3>
                <p class="management-desc">İş pozisyonlarını tanımla ve yönet</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.TotalJobs</strong> Pozisyon</span>
                </div>
            </a>

            <a href="@Url.Action("Contracts")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-file-signature"></i>
                </div>
                <h3 class="management-title">Sözleşme Yönetimi</h3>
                <p class="management-desc">Çalışan sözleşmelerini görüntüle ve yönet</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.ActiveContracts</strong> Aktif</span>
                </div>
            </a>

            <a href="@Url.Action("LeaveRequests")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h3 class="management-title">İzin Yönetimi</h3>
                <p class="management-desc">Tüm izin taleplerini onayla veya reddet</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.PendingLeaves</strong> Bekleyen</span>
                </div>
            </a>

            <a href="@Url.Action("PerformanceReviews")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #ff9a00 0%, #feca57 100%);">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3 class="management-title">Performans Yönetimi</h3>
                <p class="management-desc">Çalışan performanslarını değerlendir</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.TotalPerformanceReviews</strong> Değerlendirme</span>
                </div>
            </a>

            <a href="@Url.Action("Users")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="fas fa-user-lock"></i>
                </div>
                <h3 class="management-title">Kullanıcı Yönetimi</h3>
                <p class="management-desc">Kullanıcıları ve rollerini yönet</p>
                <div class="management-stats">
                    <span class="management-stat"><strong>@ViewBag.TotalUsers</strong> Kullanıcı</span>
                </div>
            </a>

            <a href="@Url.Action("Reports")" class="management-card">
                <div class="management-icon" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <h3 class="management-title">Raporlar</h3>
                <p class="management-desc">Detaylı raporlar ve istatistikler</p>
                <div class="management-stats">
                    <span class="management-stat">Tüm Veriler</span>
                </div>
            </a>
        </div>

        <!-- Recent Activities -->
        <div class="recent-section">
            <!-- Son Eklenen Çalışanlar -->
            <div class="activity-card">
                <h3 class="section-title">
                    <i class="fas fa-user-plus"></i> Son Eklenen Çalışanlar
                </h3>
                @if (ViewBag.RecentEmployees != null && ((List<HRDms.Data.Models.Employee>)ViewBag.RecentEmployees).Any())
                {
                    @foreach (var emp in (List<HRDms.Data.Models.Employee>)ViewBag.RecentEmployees)
                    {
                        <div class="activity-item" style="border-color: #667eea;">
                            <div class="activity-title">@emp.FirstName @emp.LastName</div>
                            <div class="activity-meta">
                                <i class="fas fa-building"></i> @(emp.Department?.DepartmentName ?? "N/A") |
                                <i class="fas fa-briefcase"></i> @(emp.Job?.JobTitle ?? "N/A")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-user-slash"></i>
                        <p>Henüz çalışan eklenmedi</p>
                    </div>
                }
            </div>

            <!-- Bekleyen İzin Talepleri -->
            <div class="activity-card">
                <h3 class="section-title">
                    <i class="fas fa-clock"></i> Bekleyen İzin Talepleri
                </h3>
                @if (ViewBag.RecentLeaves != null && ((List<HRDms.Data.Models.LeaveRequest>)ViewBag.RecentLeaves).Any())
                {
                    @foreach (var leave in (List<HRDms.Data.Models.LeaveRequest>)ViewBag.RecentLeaves)
                    {
                        <div class="activity-item" style="border-color: #fa709a;">
                            <div class="activity-title">@leave.Employee.FirstName @leave.Employee.LastName</div>
                            <div class="activity-meta">
                                <i class="fas fa-tag"></i> @(leave.LeaveType?.TypeName ?? "İzin") |
                                <i class="fas fa-calendar"></i> @leave.StartDate.ToString("dd.MM.yyyy") - @leave.EndDate.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-check-circle"></i>
                        <p>Bekleyen izin talebi yok</p>
                    </div>
                }
            </div>

            <!-- Son Sözleşmeler -->
            <div class="activity-card">
                <h3 class="section-title">
                    <i class="fas fa-file-contract"></i> Son Oluşturulan Sözleşmeler
                </h3>
                @if (ViewBag.RecentContracts != null && ((List<HRDms.Data.Models.EmploymentContract>)ViewBag.RecentContracts).Any())
                {
                    @foreach (var contract in (List<HRDms.Data.Models.EmploymentContract>)ViewBag.RecentContracts)
                    {
                        <div class="activity-item" style="border-color: #4facfe;">
                            <div class="activity-title">@contract.Employee.FirstName @contract.Employee.LastName</div>
                            <div class="activity-meta">
                                <i class="fas fa-file-alt"></i> @contract.ContractType |
                                <i class="fas fa-calendar-check"></i> @contract.StartDate.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-file-contract"></i>
                        <p>Henüz sözleşme oluşturulmadı</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
