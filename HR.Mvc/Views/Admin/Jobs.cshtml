@model List<HRDms.Data.Models.Job>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Admin - Pozisyon Yönetimi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Pozisyon Yönetimi</h2>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Admin Paneline Dön
            </a>
        </div>

        <table class="table table-striped table-bordered table-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Pozisyon</th>
                    <th>Çalışan Sayısı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model)
                {
                    <tr>
                        <td>@j.JobId</td>
                        <td>@j.JobTitle</td>
                        <td>@(j.Employees?.Count ?? 0)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
</body>
</html>